{
	"name": "splite",
	"version": "0.0.1",
	"keywords": [
		"svelte"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build && pnpm run prepack",
		"preview": "vp preview",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
